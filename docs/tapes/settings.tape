# Shared look for every recording.
Set Shell "bash"
Set FontSize 16
Set Width 1400
Set Height 820
Set Padding 24
Set Framerate 30
Set TypingSpeed 70ms
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 0
Set Theme { "name": "gotham", "black": "#0B0B0F", "red": "#F87171", "green": "#4ADE80", "yellow": "#FFD500", "blue": "#60A5FA", "magenta": "#C4B5FD", "cyan": "#67E8F9", "white": "#D8DAE5", "brightBlack": "#6B7084", "brightRed": "#FCA5A5", "brightGreen": "#86EFAC", "brightYellow": "#FDE68A", "brightBlue": "#93C5FD", "brightMagenta": "#DDD6FE", "brightCyan": "#A5F3FC", "brightWhite": "#F5F5F0", "background": "#11131B", "foreground": "#D8DAE5", "cursor": "#FFD500", "selection": "#1C1F2B" }
Env JENKINS_TOKEN "demo"
Env PS1 "$ "
